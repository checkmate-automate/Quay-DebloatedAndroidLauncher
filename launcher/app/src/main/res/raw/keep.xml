<?xml version="1.0" encoding="utf-8"?>
<!-- A tile may name its icon as a string in config.xml ("icon:ic_app_tile"), resolved with
     getIdentifier at runtime. The resource shrinker cannot see a lookup by name, so without this it strips
     the drawable and the tile silently falls back to the generic input mark. -->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_app_tile,@drawable/ic_input_tile" />
